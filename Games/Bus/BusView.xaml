<UserControl x:Class="Layts.Games.Bus.BusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Setting with a switch -->
        <DataTemplate x:Key="ToggleRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Setting with a slider -->
        <DataTemplate x:Key="SliderRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="230" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" VerticalAlignment="Center"/>
                        <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ValueText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Profile entry -->
        <DataTemplate x:Key="ProfileItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoft}" Margin="0,0,11,0">
                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- Slot entry in the save menu -->
        <DataTemplate x:Key="SlotItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,11,0">
                    <TextBlock Text="&#xE806;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Hero ===================== -->
        <Grid ClipToBounds="True">
            <Border Background="{StaticResource Surface}"/>
            <Image Source="{Binding HeroImage}" Stretch="UniformToFill" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.3">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E60E0E10" Offset="0"/>
                        <GradientStop Color="#660E0E10" Offset="0.45"/>
                        <GradientStop Color="#1A0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400E0E10" Offset="0"/>
                        <GradientStop Color="#000E0E10" Offset="0.35"/>
                        <GradientStop Color="#FF0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,22,0,0"
                    Background="#B30E0E10" BorderBrush="#33FFFFFF" Padding="12,7" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{core:Tr Library}" FontSize="12.5"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,22"
                        core:Anim.FadeIn="True" core:Anim.Delay="120" core:Anim.Offset="20">
                <Grid HorizontalAlignment="Left">
                    <Image Source="{Binding LogoImage}" MaxHeight="96" MaxWidth="320" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="The Bus" FontSize="32">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogoImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC122219"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                        <Setter Property="Background" Value="#CC272010"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{core:Tr GameClosed}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Text" Value="{core:Tr GameRunning}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,5" Background="#CC2B1910">
                        <TextBlock Text="{core:Tr Bus_Chip}" FontSize="12" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1" Margin="40,6,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <!-- Placeholder -->
                <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{core:Tr NoSaveLoaded}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{core:Tr LoadingSave}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13.5" Margin="0,6,0,0" Text="{core:Tr Bus_PickHint}"/>
                </StackPanel>

                <TabControl Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">

                    <!-- ===== Career ===== -->
                    <TabItem Header="{core:Tr Bus_TabCareer}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}" Padding="20"
                                        Visibility="{Binding HasCareer, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{core:Tr Bus_NoCareer}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{core:Tr Bus_NoCareerDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding HasCareer, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Bus_Company}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Bus_CompanyDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                            <TextBlock Text="{core:Tr Bus_Budget}" Style="{StaticResource RowTitle}"/>
                                                            <TextBlock Text="{core:Tr Bus_BudgetDesc}" Style="{StaticResource Caption}"/>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Width="220" Style="{StaticResource NumberBox}" Tag="€"
                                                                 Text="{Binding BudgetText, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </Grid>
                                                    <WrapPanel Margin="0,12,0,0">
                                                        <Button Style="{StaticResource ChipButton}" Content="+ 100.000" Command="{Binding AddBudgetCommand}" CommandParameter="100000"/>
                                                        <Button Style="{StaticResource ChipButton}" Content="+ 1.000.000" Command="{Binding AddBudgetCommand}" CommandParameter="1000000"/>
                                                        <Button Style="{StaticResource ChipButton}" Content="+ 10.000.000" Command="{Binding AddBudgetCommand}" CommandParameter="10000000"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource RowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Bus_Reputation}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Bus_ReputationDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding Reputation}" VerticalAlignment="Center"/>
                                                        <TextBlock Width="40" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Reputation}"/>
                                                        <Button Style="{StaticResource SoftButton}" Content="Max" Command="{Binding MaxReputationCommand}" Margin="10,0,0,0" Padding="12,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Bus_Fleet}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Bus_FleetDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Bus_Repair}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Bus_RepairDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding RepairBuses}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource RowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Bus_Clean}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Bus_CleanDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding CleanBuses}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{core:Tr Bus_Staff}" Style="{StaticResource H2}"/>
                                                        <TextBlock Text="{core:Tr Bus_StaffDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bus_MaxExp}" Command="{Binding MaxExperienceCommand}" Margin="0,0,8,0"/>
                                                        <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bus_AllHappy}" Command="{Binding AllSatisfiedCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Employees}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Row}" Padding="20,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0"
                                                                            Visibility="{Binding HasExperience, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{core:Tr Bus_ExpShort}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Experience}" VerticalAlignment="Center"/>
                                                                    <TextBlock Width="34" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Experience}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0"
                                                                            Visibility="{Binding HasSatisfaction, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{core:Tr Bus_SatShort}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding Satisfaction}" VerticalAlignment="Center"/>
                                                                    <TextBlock Width="34" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Satisfaction}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Driving ===== -->
                    <TabItem Header="{core:Tr Bus_TabDriving}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Bus_Wheel}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Bus_WheelDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}" Visibility="{Binding HasWheelAngle, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Bus_WheelAngle}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Bus_WheelAngleDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="140" Style="{StaticResource NumberBox}" Tag="°"
                                                             Text="{Binding WheelAngleText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button Style="{StaticResource ChipButton}" Content="{core:Tr Bus_Auto}" Command="{Binding SetWheelAngleCommand}" CommandParameter="0"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="270°" Command="{Binding SetWheelAngleCommand}" CommandParameter="270"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="360°" Command="{Binding SetWheelAngleCommand}" CommandParameter="360"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="540°" Command="{Binding SetWheelAngleCommand}" CommandParameter="540"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="720°" Command="{Binding SetWheelAngleCommand}" CommandParameter="720"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="900°" Command="{Binding SetWheelAngleCommand}" CommandParameter="900"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="1080°" Command="{Binding SetWheelAngleCommand}" CommandParameter="1080"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding WheelToggles}" ItemTemplate="{StaticResource ToggleRow}"/>
                                        <ItemsControl ItemsSource="{Binding WheelSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Bus_Simplify}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Bus_SimplifyDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bus_Realistic}" Command="{Binding NoSimpleCommand}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bus_AllSimple}" Command="{Binding AllSimpleCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Simplifications}" ItemTemplate="{StaticResource ToggleRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Bus_Gameplay}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Bus_Autosave}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Bus_AutosaveDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Width="140" Style="{StaticResource NumberBox}" Tag="min"
                                                         Text="{Binding AutosaveText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding GameplayToggles}" ItemTemplate="{StaticResource ToggleRow}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Traffic & sound ===== -->
                    <TabItem Header="{core:Tr Bus_TabWorld}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Bus_TrafficTitle}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Bus_TrafficDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding TrafficSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                        <Border Style="{StaticResource RowLast}" Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Bus_Comments}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Bus_CommentsDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Width="200" ItemsSource="{Binding CommentOptions}" SelectedIndex="{Binding CommentIndex}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Sw_Audio}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding AudioSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Camera & plates ===== -->
                    <TabItem Header="{core:Tr Bus_TabCamera}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Bus_Camera}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_Fov}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Bus_FovDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider Width="230" Minimum="50" Maximum="120" Value="{Binding Fov}" VerticalAlignment="Center"/>
                                                    <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Text="{Binding Fov}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding CameraSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Bus_Plates}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Bus_PlatesDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Plates}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="20,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Vehicle}" Style="{StaticResource RowTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBox Grid.Column="1" Width="180" MaxLength="16" Text="{Binding Plate, UpdateSourceTrigger=PropertyChanged}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Wheel buttons ===== -->
                    <TabItem Header="{core:Tr Wh_Tab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Wheel}">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Wh_Title}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Wh_Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Wh_Enabled}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Wh_EnabledDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Wh_Devices}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding DevicesText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                                        <Run Text="{core:Tr Wh_Live}"/>
                                                        <Run Text="{Binding LiveText, Mode=OneWay}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource SmallButton}" Content="{core:Tr Refresh}" Command="{Binding RefreshDevicesCommand}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource SearchBox}" Tag="{core:Tr Wh_Search}" Margin="0,0,12,0"
                                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Wh_Cancel}" Command="{Binding CancelCaptureCommand}" Margin="0,0,8,0"
                                                            Visibility="{Binding IsCapturing, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Padding="16,0" Height="36">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{core:Tr Wh_Add}"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Background="{StaticResource AccentSoft}" Padding="20,10"
                                                Visibility="{Binding Hint, Converter={StaticResource TextToVis}}">
                                            <TextBlock Text="{Binding Hint}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </Border>
                                        <TextBlock Text="{core:Tr Wh_Empty}" Style="{StaticResource Caption}" Margin="20,18" TextWrapping="Wrap"
                                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding View}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="20,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding InputText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding DeviceName}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <Grid Grid.Column="1" Margin="0,0,10,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Style="{StaticResource SearchBox}" Tag="{core:Tr Wh_ActionHint}"
                                                                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <ComboBox Grid.Column="1" Width="44" Margin="6,0,0,0" ToolTip="{core:Tr Wh_Suggestions}"
                                                                          ItemsSource="{Binding DataContext.Wheel.LabelSuggestions, ElementName=Root}"
                                                                          SelectedItem="{Binding PickedSuggestion}"/>
                                                            </Grid>
                                                            <TextBox Grid.Column="2" Width="130" core:KeyCapture.Key="{Binding Key}" ToolTip="{core:Tr Wh_KeyTip}"
                                                                     HorizontalContentAlignment="Center"/>
                                                            <Button Grid.Column="3" Style="{StaticResource SmallButton}" Command="{Binding ReassignCommand}" Margin="8,0,0,0"
                                                                    ToolTip="{core:Tr Wh_Reassign}" Padding="10,0">
                                                                <TextBlock Text="&#xE7C9;" Style="{StaticResource Icon}" FontSize="12"/>
                                                            </Button>
                                                            <Button Grid.Column="4" Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}" Margin="6,0,0,0"
                                                                    ToolTip="{core:Tr Wh_Remove}" Padding="10,0">
                                                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource Danger}"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Padding="20" Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{core:Tr HowTo}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                                        <TextBlock Text="{core:Tr Wh_How1}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{core:Tr Wh_How2}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{core:Tr Wh_How3}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{core:Tr Wh_How4}" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Backups ===== -->
                    <TabItem Header="{core:Tr TabBackups}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr TabBackups}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Bus_BackupsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr OpenFolder}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bk_Now}" Command="{Binding BackupNowCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Bk_ThisGame}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding BackupHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoBackupThisGame}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{core:Tr Sw_NoBackups}" Margin="20,18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Backups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="20,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource Faint}" Margin="0,0,14,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" FontSize="13.5"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,16,0"/>
                                                            <Button Grid.Column="3" Content="{core:Tr Restore}" Padding="12,6" FontSize="12.5"
                                                                    Command="{Binding DataContext.RestoreBackupCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===== Right: slot & save ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14,0,28">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{core:Tr ProfileHeader}" Style="{StaticResource Overline}"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      ItemTemplate="{StaticResource ProfileItem}" MinHeight="46"/>
                            <TextBlock Text="{core:Tr Bus_CareerSave}" Style="{StaticResource Overline}" Margin="0,16,0,8"/>
                            <ComboBox ItemsSource="{Binding CareerSaves}" SelectedItem="{Binding SelectedCareer}"
                                      ItemTemplate="{StaticResource SlotItem}" MinHeight="54"/>
                            <TextBlock Text="{core:Tr Bus_NoCareerSaves}" Style="{StaticResource Caption}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasCareerSaves, Converter={StaticResource InvBoolToVis}}"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Refresh}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}" Command="{Binding OpenSaveFolderCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Folder}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Button Command="{Binding SaveCommand}" Height="48" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JustSaved}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                                <Setter Property="Foreground" Value="#0E0E10"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding JustSaved, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr SaveChanges}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" core:Anim.Pop="True"
                                                Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr Saved}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding BackupHint}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

                            <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0" BorderThickness="1"
                                    core:Anim.FadeIn="True" core:Anim.Offset="8"
                                    Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource LineHover}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12.5"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18,20,8"
                            Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{core:Tr Overview}" Style="{StaticResource Overline}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{core:Tr Bus_Budget}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding BudgetStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="1" Text="{core:Tr Bus_Reputation}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReputationStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="2" Text="{core:Tr Bus_Staff}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StaffStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="3" Text="{core:Tr Bus_Buses}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BusStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="4" Text="{core:Tr Bus_Condition}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConditionStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="5" Text="{core:Tr Bus_Cleanliness}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CleanStat}" Style="{StaticResource StatValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="{core:Tr HowTo}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="{core:Tr Sw_HowTo1}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr HowTo2}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBlock Text="{core:Tr Bus_HowTo3}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr Bus_Note}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
