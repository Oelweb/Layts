<UserControl x:Class="Layts.Games.Spm.SpmView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Setting with a switch -->
        <DataTemplate x:Key="ToggleRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}"/>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Token with a number box -->
        <DataTemplate x:Key="TokenRow">
            <Border Style="{StaticResource Row}" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Width="140" Style="{StaticResource NumberBox}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Setting with a slider -->
        <DataTemplate x:Key="SliderRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Width="230" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}" VerticalAlignment="Center"/>
                        <TextBlock Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ValueText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Profile entry -->
        <DataTemplate x:Key="ProfileItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource AccentSoft}" Margin="0,0,11,0">
                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>

        <!-- Slot entry in the save menu -->
        <DataTemplate x:Key="SlotItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,11,0">
                    <TextBlock Text="&#xE806;" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Hero ===================== -->
        <Grid ClipToBounds="True">
            <Border Background="{StaticResource Surface}"/>
            <Image Source="{Binding HeroImage}" Stretch="UniformToFill" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.3">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E60E0E10" Offset="0"/>
                        <GradientStop Color="#660E0E10" Offset="0.45"/>
                        <GradientStop Color="#1A0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400E0E10" Offset="0"/>
                        <GradientStop Color="#000E0E10" Offset="0.35"/>
                        <GradientStop Color="#FF0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,22,0,0"
                    Background="#B30E0E10" BorderBrush="#33FFFFFF" Padding="12,7" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{core:Tr Library}" FontSize="12.5"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,22"
                        core:Anim.FadeIn="True" core:Anim.Delay="120" core:Anim.Offset="20">
                <Grid HorizontalAlignment="Left">
                    <Image Source="{Binding LogoImage}" MaxHeight="96" MaxWidth="320" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="Marvel's Spider-Man Remastered" FontSize="32">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogoImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC122219"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                        <Setter Property="Background" Value="#CC272010"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{core:Tr GameClosed}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Text" Value="{core:Tr GameRunning}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,5" Background="#CC2B1910">
                        <TextBlock Text="{core:Tr Sm_Chip}" FontSize="12" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1" Margin="40,6,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <!-- Placeholder -->
                <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{core:Tr NoSaveLoaded}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{core:Tr LoadingSave}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13.5" Margin="0,6,0,0" Text="{core:Tr Sm_PickHint}"/>
                </StackPanel>

                <TabControl Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">

                    <!-- ===== Progress & map ===== -->
                    <TabItem Header="{core:Tr Sm_TabProgress}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sm_Xp}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{Binding LevelInfo}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sm_TotalXp}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sm_TotalXpDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="200" Style="{StaticResource NumberBox}" Tag="EP"
                                                             Text="{Binding XpText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                                <WrapPanel Margin="0,12,0,0">
                                                    <Button Style="{StaticResource ChipButton}" Content="+ 5.000" Command="{Binding AddXpCommand}" CommandParameter="5000"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="+ 25.000" Command="{Binding AddXpCommand}" CommandParameter="25000"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="+ 100.000" Command="{Binding AddXpCommand}" CommandParameter="100000"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding HasTokens, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel Margin="0,0,200,0">
                                                    <TextBlock Text="{core:Tr Sm_Tokens}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sm_TokensDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sm_Tokens50}" Command="{Binding TokensCommand}" CommandParameter="50" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sm_Tokens99}" Command="{Binding TokensCommand}" CommandParameter="99"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Tokens}" ItemTemplate="{StaticResource TokenRow}"/>
                                        <Border Padding="20,12,20,4" Visibility="{Binding HasOtherTokens, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sm_OtherTokens}" Style="{StaticResource Overline}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{core:Tr Sm_OtherTokensDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding OtherTokens}" ItemTemplate="{StaticResource TokenRow}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding HasChallenges, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sm_Activities}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Sm_ActivitiesDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}" Visibility="{Binding HasActivities, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_CompleteActivities}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding ActivityInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding CompleteActivities}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_CompleteChallenges}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding ChallengeInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding CompleteChallenges}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sm_Map}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Sm_MapDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}" Visibility="{Binding HasTowers, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_ActivateTowers}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding TowerInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding ActivateTowers}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}" Visibility="{Binding HasLandmarks, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_ShowLandmarks}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding LandmarkInfo}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding ShowLandmarks}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}" Visibility="{Binding HasLandmarks, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_DiscoverLandmarks}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sm_DiscoverLandmarksDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding DiscoverLandmarks}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Visibility="{Binding HasNewGamePlus, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Sm_Unlocks}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sm_NewGamePlus}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sm_NewGamePlusDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding NewGamePlus}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Game options ===== -->
                    <TabItem Header="{core:Tr Sm_TabOptions}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel Margin="0,0,180,0">
                                                    <TextBlock Text="{core:Tr Sm_Options}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sm_OptionsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sm_AllHelps}" Command="{Binding AllHelpsCommand}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SlotOptions}" ItemTemplate="{StaticResource ToggleRow}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Mouse & PC ===== -->
                    <TabItem Header="{core:Tr Sm_TabPc}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}" Visibility="{Binding HasPrefs, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel Margin="0,0,120,0">
                                                    <TextBlock Text="{core:Tr Sm_Mouse}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sm_MouseDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sm_Default}" Command="{Binding ResetMouseCommand}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding MouseSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                        <ItemsControl ItemsSource="{Binding MouseToggles}" ItemTemplate="{StaticResource ToggleRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Visibility="{Binding HasPcSettings, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sm_Pc}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Sm_PcDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding PcToggles}" ItemTemplate="{StaticResource ToggleRow}"/>
                                        <ItemsControl ItemsSource="{Binding PcSliders}" ItemTemplate="{StaticResource SliderRow}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Backups ===== -->
                    <TabItem Header="{core:Tr TabBackups}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr TabBackups}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sm_BackupsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr OpenFolder}" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Bk_Now}" Command="{Binding BackupNowCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Bk_ThisGame}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{Binding BackupHint}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding AutoBackupThisGame}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{core:Tr Sw_NoBackups}" Margin="20,18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Backups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="20,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource Faint}" Margin="0,0,14,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" FontSize="13.5"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,16,0"/>
                                                            <Button Grid.Column="3" Content="{core:Tr Restore}" Padding="12,6" FontSize="12.5"
                                                                    Command="{Binding DataContext.RestoreBackupCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===== Right: slot & save ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14,0,28">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{core:Tr Sm_Account}" Style="{StaticResource Overline}"/>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                      ItemTemplate="{StaticResource ProfileItem}" MinHeight="46"/>
                            <TextBlock Text="{core:Tr Sm_Save}" Style="{StaticResource Overline}" Margin="0,16,0,8"/>
                            <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                      ItemTemplate="{StaticResource SlotItem}" MinHeight="54"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Refresh}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}" Command="{Binding OpenSaveFolderCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Folder}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Button Command="{Binding SaveCommand}" Height="48" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JustSaved}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                                <Setter Property="Foreground" Value="#0E0E10"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding JustSaved, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr SaveChanges}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" core:Anim.Pop="True"
                                                Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr Saved}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="{Binding BackupHint}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Caption}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

                            <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0" BorderThickness="1"
                                    core:Anim.FadeIn="True" core:Anim.Offset="8"
                                    Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource LineHover}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12.5"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18,20,8"
                            Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{core:Tr Overview}" Style="{StaticResource Overline}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{core:Tr Sm_Completion}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PercentStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="1" Text="{core:Tr Sm_PlayTime}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlayStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="2" Text="{core:Tr Sm_Towers}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TowerStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="3" Text="{core:Tr Sm_Landmarks}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LandmarkStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="4" Text="{core:Tr Sm_Challenges}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ChallengeStat}" Style="{StaticResource StatValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="{core:Tr HowTo}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="{core:Tr Sw_HowTo1}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr HowTo2}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBlock Text="{core:Tr Sm_HowTo3}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr Sm_Note}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
