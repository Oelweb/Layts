<UserControl x:Class="Layts.Games.Swyf.SwyfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core"
             x:Name="Root">

    <UserControl.Resources>
        <!-- App / scam with on/off switch -->
        <DataTemplate x:Key="ProductRow">
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                            <Border CornerRadius="9" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface3}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding KindText}" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPermanent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Visibility="{Binding Description, Converter={StaticResource TextToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UnlockText}" Style="{StaticResource Caption}" FontSize="11.5" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <CheckBox Grid.Column="2" IsChecked="{Binding IsOwned}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Slot entry in the save menu -->
        <DataTemplate x:Key="SlotItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Surface2}" Margin="0,0,11,0">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================== Hero ===================== -->
        <Grid ClipToBounds="True">
            <Border Background="{StaticResource Surface}"/>
            <Image Source="{Binding HeroImage}" Stretch="UniformToFill" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.3">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                </Image.RenderTransform>
                <Image.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1.08" To="1" Duration="0:0:1.8">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Image.Triggers>
            </Image>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E60E0E10" Offset="0"/>
                        <GradientStop Color="#660E0E10" Offset="0.45"/>
                        <GradientStop Color="#1A0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#400E0E10" Offset="0"/>
                        <GradientStop Color="#000E0E10" Offset="0.35"/>
                        <GradientStop Color="#FF0E0E10" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Command="{Binding BackCommand}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,22,0,0"
                    Background="#B30E0E10" BorderBrush="#33FFFFFF" Padding="12,7" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{core:Tr Library}" FontSize="12.5"/>
                </StackPanel>
            </Button>

            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,22"
                        core:Anim.FadeIn="True" core:Anim.Delay="120" core:Anim.Offset="20">
                <Grid HorizontalAlignment="Left">
                    <Image Source="{Binding LogoImage}" MaxHeight="96" MaxWidth="320" Stretch="Uniform" HorizontalAlignment="Left"/>
                    <TextBlock Text="Scam With Your Friends" FontSize="32">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LogoImage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Border CornerRadius="12" Padding="10,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#CC122219"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                        <Setter Property="Background" Value="#CC272010"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{core:Tr GameClosed}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Text" Value="{core:Tr GameRunning}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,5" Background="#CC2B1910">
                        <TextBlock Text="{core:Tr Sw_EarlyAccess}" FontSize="12" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===================== Content ===================== -->
        <Grid Grid.Row="1" Margin="40,6,40,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <!-- Placeholder -->
                <StackPanel VerticalAlignment="Top" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoaded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{core:Tr NoSaveLoaded}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Text" Value="{core:Tr LoadingSave}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" FontSize="13.5" Margin="0,6,0,0" Text="{core:Tr Sw_PickSlotHint}"/>
                </StackPanel>

                <TabControl Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">

                    <!-- ===== Run ===== -->
                    <TabItem Header="{core:Tr Sw_TabRun}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}" Padding="20"
                                        Visibility="{Binding HasRun, Converter={StaticResource InvBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{core:Tr Sw_NoRunTitle}" Style="{StaticResource H2}"/>
                                        <TextBlock Text="{core:Tr Sw_NoRunDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Visibility="{Binding HasRun, Converter={StaticResource BoolToVis}}">
                                    <!-- Money -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Sw_Money}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_MoneyDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding Players}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Row}">
                                                            <StackPanel>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource RowTitle}"/>
                                                                        <TextBlock Text="{Binding SteamIdText}" Style="{StaticResource Caption}"/>
                                                                        <TextBlock Text="{Binding MoneyError}" Foreground="{StaticResource Danger}" FontSize="12" Margin="0,4,0,0"
                                                                                   Visibility="{Binding MoneyError, Converter={StaticResource TextToVis}}"/>
                                                                    </StackPanel>
                                                                    <TextBox Grid.Column="1" Width="220" Style="{StaticResource NumberBox}" Tag="$"
                                                                             Text="{Binding MoneyText, UpdateSourceTrigger=PropertyChanged}"/>
                                                                </Grid>
                                                                <WrapPanel Margin="0,12,0,0">
                                                                    <Button Style="{StaticResource ChipButton}" Content="+ 1,000" Command="{Binding AddCommand}" CommandParameter="1000"/>
                                                                    <Button Style="{StaticResource ChipButton}" Content="+ 10,000" Command="{Binding AddCommand}" CommandParameter="10000"/>
                                                                    <Button Style="{StaticResource ChipButton}" Content="+ 100,000" Command="{Binding AddCommand}" CommandParameter="100000"/>
                                                                    <Button Style="{StaticResource ChipButton}" Content="+ 1,000,000" Command="{Binding AddCommand}" CommandParameter="1000000"/>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Day -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Sw_DayTitle}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_DayTitleDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sw_Day}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sw_DayDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="{core:Tr Sw_DayUnit}"
                                                             Text="{Binding DayText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sw_DayLength}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sw_DayLengthDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="min"
                                                             Text="{Binding DayLengthText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource RowLast}">
                                                <WrapPanel>
                                                    <Button Style="{StaticResource ChipButton}" Content="{core:Tr Sw_Min15}" Command="{Binding SetDayLengthCommand}" CommandParameter="15"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="{core:Tr Sw_Min30}" Command="{Binding SetDayLengthCommand}" CommandParameter="30"/>
                                                    <Button Style="{StaticResource ChipButton}" Content="{core:Tr Sw_Min60}" Command="{Binding SetDayLengthCommand}" CommandParameter="60"/>
                                                </WrapPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quota -->
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Border Style="{StaticResource CardHeader}">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{core:Tr Sw_Quota}" Style="{StaticResource H2}"/>
                                                        <TextBlock Text="{core:Tr Sw_QuotaDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_Default}" Command="{Binding DefaultQuotaCommand}" Margin="0,0,8,0"/>
                                                        <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_EasyQuota}" Command="{Binding EasyQuotaCommand}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sw_StartQuota}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sw_StartQuotaDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="$"
                                                             Text="{Binding StartQuotaText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sw_ExtraQuota}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sw_ExtraQuotaDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="$"
                                                             Text="{Binding ExtraQuotaText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource RowLast}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                        <TextBlock Text="{core:Tr Sw_Increase}" Style="{StaticResource RowTitle}"/>
                                                        <TextBlock Text="{core:Tr Sw_IncreaseDesc}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                    <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="%"
                                                             Text="{Binding QuotaIncreaseText, UpdateSourceTrigger=PropertyChanged}"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Apps ===== -->
                    <TabItem Header="{core:Tr Sw_TabApps}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Sw_Scams}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_ScamsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_None}" Command="{Binding LockAllScamsCommand}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_UnlockAll}" Command="{Binding UnlockAllScamsCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Scams}" ItemTemplate="{StaticResource ProductRow}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Sw_Apps}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_AppsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_None}" Command="{Binding LockAllAppsCommand}" Margin="0,0,8,0"/>
                                                    <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_UnlockAll}" Command="{Binding UnlockAllAppsCommand}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource ProductRow}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding CatalogSource}" Style="{StaticResource Caption}" FontSize="12" Margin="4,0,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Cosmetics ===== -->
                    <TabItem Header="{core:Tr Sw_TabCosmetics}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr Sw_Emotes}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_EmotesDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource SmallButton}" Content="{core:Tr Sw_UnlockAll}" Command="{Binding UnlockAllEmotesCommand}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{core:Tr Sw_NoEmotes}" Style="{StaticResource Caption}" Margin="20,18"
                                                   Visibility="{Binding HasEmotes, Converter={StaticResource InvBoolToVis}}"/>
                                        <ItemsControl ItemsSource="{Binding Emotes}" Margin="20,16,12,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding Name}" IsChecked="{Binding IsOn}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <Border Style="{StaticResource RowLast}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="{core:Tr Sw_Curry}" Style="{StaticResource RowTitle}"/>
                                                <TextBlock Text="{core:Tr Sw_CurryDesc}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding CurrySuit}"/>
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Game settings ===== -->
                    <TabItem Header="{core:Tr Sw_TabSettings}" Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <StackPanel>
                                                <TextBlock Text="{core:Tr Sw_Display}" Style="{StaticResource H2}"/>
                                                <TextBlock Text="{core:Tr Sw_DisplayDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_Fov}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_FovDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Slider Width="230" Minimum="50" Maximum="120" Value="{Binding Fov}" VerticalAlignment="Center"/>
                                                    <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                                               Text="{Binding Fov}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_Fps}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_FpsDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="FPS"
                                                         Text="{Binding FpsText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <WrapPanel>
                                                <Button Style="{StaticResource ChipButton}" Content="60" Command="{Binding SetFpsCommand}" CommandParameter="60"/>
                                                <Button Style="{StaticResource ChipButton}" Content="144" Command="{Binding SetFpsCommand}" CommandParameter="144"/>
                                                <Button Style="{StaticResource ChipButton}" Content="240" Command="{Binding SetFpsCommand}" CommandParameter="240"/>
                                                <Button Style="{StaticResource ChipButton}" Content="{core:Tr Sw_Unlimited}" Command="{Binding SetFpsCommand}" CommandParameter="-1"/>
                                            </WrapPanel>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_HideUi}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_HideUiDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding HideGameUi}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_HideKeys}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_HideKeysDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding HideKeysUi}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Sw_Controls}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_Sens}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_SensDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <TextBox Grid.Column="1" Width="160" Style="{StaticResource NumberBox}" Tag="%"
                                                         Text="{Binding SensitivityText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,24,0">
                                                    <TextBlock Text="{core:Tr Sw_Sprint}" Style="{StaticResource RowTitle}"/>
                                                    <TextBlock Text="{core:Tr Sw_SprintDesc}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding ToggleSprint}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <TextBlock Text="{core:Tr Sw_Audio}" Style="{StaticResource H2}"/>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{core:Tr Sw_Master}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Slider Width="230" Minimum="0" Maximum="100" Value="{Binding MasterVolume}" VerticalAlignment="Center"/>
                                                    <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding MasterVolume}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{core:Tr Sw_Music}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Slider Width="230" Minimum="0" Maximum="100" Value="{Binding MusicVolume}" VerticalAlignment="Center"/>
                                                    <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding MusicVolume}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{core:Tr Sw_Explosions}" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Slider Width="230" Minimum="0" Maximum="100" Value="{Binding ExplosionsVolume}" VerticalAlignment="Center"/>
                                                    <TextBlock Width="48" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding ExplosionsVolume}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Backups ===== -->
                    <TabItem Header="{core:Tr TabBackups}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,28">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Border Style="{StaticResource CardHeader}">
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{core:Tr TabBackups}" Style="{StaticResource H2}"/>
                                                    <TextBlock Text="{core:Tr Sw_BackupsDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource SmallButton}" Content="{core:Tr OpenFolder}" Command="{Binding OpenBackupFolderCommand}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{core:Tr Sw_NoBackups}" Margin="20,18">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Backups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="20,11">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Foreground="{StaticResource Faint}" Margin="0,0,14,0"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" FontSize="13.5"/>
                                                            <Button Grid.Column="2" Content="{core:Tr Restore}" Padding="12,6" FontSize="12.5"
                                                                    Command="{Binding DataContext.RestoreBackupCommand, ElementName=Root}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ===== Right: slot & save ===== -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,14,0,28">
                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <TextBlock Text="{core:Tr SaveHeader}" Style="{StaticResource Overline}"/>
                            <ComboBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                                      ItemTemplate="{StaticResource SlotItem}" MinHeight="54"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SmallButton}" Command="{Binding RefreshCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Refresh}"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource SmallButton}" Command="{Binding OpenSaveFolderCommand}" Height="34">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr Folder}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20">
                        <StackPanel>
                            <Button Command="{Binding SaveCommand}" Height="48" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JustSaved}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Success}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                                <Setter Property="Foreground" Value="#0E0E10"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Visibility="{Binding JustSaved, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr SaveChanges}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" core:Anim.Pop="True"
                                                Visibility="{Binding JustSaved, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontWeight="Bold" Margin="0,0,10,0"/>
                                        <TextBlock Text="{core:Tr Saved}"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="{core:Tr BackupFirst}" Style="{StaticResource Caption}" FontSize="12"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>

                            <Border CornerRadius="8" Padding="12,10" Margin="0,14,0,0" BorderThickness="1"
                                    core:Anim.FadeIn="True" core:Anim.Offset="8"
                                    Visibility="{Binding StatusText, Converter={StaticResource TextToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource LineHover}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="Success">
                                                <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Success}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="12.5"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20,18,20,8"
                            Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{core:Tr Overview}" Style="{StaticResource Overline}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{core:Tr Sw_Day}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Column="1" Text="{Binding DayStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="1" Text="{core:Tr Sw_Players}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlayerStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="2" Text="{core:Tr Sw_Scams}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ScamStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="3" Text="{core:Tr Sw_Apps}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AppStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="4" Text="{core:Tr Sw_Emotes}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EmoteStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="5" Text="{core:Tr Sw_Playtime}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PlayStat}" Style="{StaticResource StatValue}"/>
                                <TextBlock Grid.Row="6" Text="{core:Tr Sw_Achievements}" Style="{StaticResource StatLabel}"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AchievementStat}" Style="{StaticResource StatValue}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="20" Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="{core:Tr HowTo}" Style="{StaticResource Overline}" Margin="0,0,0,10"/>
                            <TextBlock Text="{core:Tr Sw_HowTo1}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr HowTo2}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,4"/>
                            <TextBlock Text="{core:Tr Sw_HowTo3}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <TextBlock Text="{core:Tr Sw_CoopNote}" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource Faint}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
