<UserControl x:Class="Layts.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core">

    <UserControl.Resources>
        <!-- Große Auswahlkarte für die Sprache -->
        <Style x:Key="LanguageCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Border x:Name="bd" CornerRadius="12" Background="{StaticResource Field}"
                                    BorderBrush="{StaticResource Line}" BorderThickness="1"/>
                            <Border x:Name="on" CornerRadius="12" Background="{StaticResource AccentSoft}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1.5" Opacity="0"/>
                            <Grid Margin="16,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter/>
                                <Border x:Name="dot" Grid.Column="2" Width="20" Height="20" CornerRadius="10"
                                        BorderBrush="{StaticResource LineHover}" BorderThickness="1.5" VerticalAlignment="Center">
                                    <Grid>
                                        <Ellipse x:Name="fill" Fill="{StaticResource Accent}" Opacity="0"/>
                                        <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="Collapsed" core:Anim.Pop="True"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sprachkürzel-Badge -->
        <Style x:Key="LangBadge" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- Flags drawn as vectors (Windows doesn't render flag emojis) -->
        <Style x:Key="Flag" TargetType="Rectangle">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="RadiusX" Value="5"/>
            <Setter Property="RadiusY" Value="5"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="#22FFFFFF"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <DrawingBrush x:Key="FlagUk" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,60,30">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#012169" Geometry="M0,0 H60 V30 H0 Z"/>
                    <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                        <GeometryDrawing.Pen><Pen Brush="White" Thickness="6"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M0,0 L60,30 M60,0 L0,30">
                        <GeometryDrawing.Pen><Pen Brush="#C8102E" Thickness="2"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White" Geometry="M25,0 H35 V30 H25 Z M0,10 H60 V20 H0 Z"/>
                    <GeometryDrawing Brush="#C8102E" Geometry="M27,0 H33 V30 H27 Z M0,12 H60 V18 H0 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <DrawingBrush x:Key="FlagDe" Stretch="Fill" ViewboxUnits="Absolute" Viewbox="0,0,5,3">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#000000" Geometry="M0,0 H5 V1 H0 Z"/>
                    <GeometryDrawing Brush="#DD0000" Geometry="M0,1 H5 V2 H0 Z"/>
                    <GeometryDrawing Brush="#FFCE00" Geometry="M0,2 H5 V3 H0 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,52,40,40" MaxWidth="860" HorizontalAlignment="Left">

            <StackPanel Margin="0,0,0,26" core:Anim.FadeIn="True">
                <TextBlock Text="{core:Tr Settings}" Style="{StaticResource H1}"/>
                <TextBlock Text="{core:Tr SettingsDesc}" Style="{StaticResource Caption}" FontSize="13.5" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== Sprache ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <StackPanel>
                            <TextBlock Text="{core:Tr Language}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{core:Tr LanguageDesc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Margin="20,18,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Style="{StaticResource LanguageCard}" GroupName="Lang" IsChecked="{Binding IsEnglish}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource Flag}" Fill="{StaticResource FlagUk}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="English" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="Default" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Grid.Column="2" Style="{StaticResource LanguageCard}" GroupName="Lang" IsChecked="{Binding IsGerman}">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Style="{StaticResource Flag}" Fill="{StaticResource FlagDe}"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Deutsch" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="German" Style="{StaticResource Caption}" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </RadioButton>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Updates ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <TextBlock Text="{core:Tr Updates}" Style="{StaticResource H2}"/>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="{core:Tr CurrentVersion}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{core:Tr CurrentVersionDesc}" Style="{StaticResource Caption}"/>
                                <TextBlock Text="{Binding Updater.Message}" FontSize="12" Foreground="{StaticResource Accent}" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding Updater.Message, Converter={StaticResource TextToVis}}"
                                           core:Anim.FadeIn="True" core:Anim.Offset="6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource Surface2}" CornerRadius="8" Padding="12,0" Height="38" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Updater.CurrentVersion, StringFormat=v{0}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                                <Button Style="{StaticResource SoftButton}" Command="{Binding Updater.CheckCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr CheckNow}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{core:Tr AutoUpdate}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{core:Tr AutoUpdateDesc}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoUpdate}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Backups ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Border Style="{StaticResource CardHeader}">
                        <StackPanel>
                            <TextBlock Text="{core:Tr TabBackups}" Style="{StaticResource H2}"/>
                            <TextBlock Text="{core:Tr Bk_Desc}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{core:Tr Bk_Auto}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{core:Tr Bk_AutoDesc}" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoBackup}"/>
                        </Grid>
                    </Border>
                    <StackPanel IsEnabled="{Binding AutoBackup}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                    <TextBlock Text="{core:Tr Bk_Interval}" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="{core:Tr Bk_IntervalDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" Width="220" ItemsSource="{Binding IntervalOptions}" SelectedIndex="{Binding IntervalIndex}"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="{core:Tr Bk_PerGame}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{core:Tr Bk_PerGameDesc}" Style="{StaticResource Caption}" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding GameBackups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13.5"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource Row}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="{core:Tr Bk_Keep}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{core:Tr Bk_KeepDesc}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Width="220" ItemsSource="{Binding KeepOptions}" SelectedIndex="{Binding KeepIndex}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource RowLast}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="{core:Tr BackupsFolder}" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="{Binding BackupFolder}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding BackupStats}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallButton}" Height="38" Command="{Binding OpenBackupFolderCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr OpenFolder}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallButton}" Height="38" Command="{Binding DeleteAllBackupsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource Danger}"/>
                                        <TextBlock Text="{core:Tr Bk_DeleteAll}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Über ===== -->
            <Border Style="{StaticResource Card}">
                <Grid Margin="20,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource LogoMark}" Width="44" Height="44" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold">
                            <Run Text="layts"/>
                            <Run Text="{Binding Updater.CurrentVersion, Mode=OneWay, StringFormat=v{0}}" Foreground="{StaticResource Faint}" FontWeight="Normal"/>
                        </TextBlock>
                        <TextBlock Text="{core:Tr AboutText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                        <TextBlock Text="{core:Tr SinglePlayerNote}" Style="{StaticResource Caption}" FontSize="12"
                                   Foreground="{StaticResource Faint}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SmallButton}" Height="38" Command="{Binding Updater.OpenRepoCommand}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                            <TextBlock Text="{core:Tr OpenGitHub}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
