<UserControl x:Class="Layts.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,52,40,40">

            <!-- ===== Kopf ===== -->
            <StackPanel Margin="0,0,0,24" core:Anim.FadeIn="True">
                <TextBlock Text="Bibliothek" Style="{StaticResource H1}"/>
                <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ===== Großes Banner ===== -->
            <Border Height="340" CornerRadius="14" Background="{StaticResource Surface}"
                    DataContext="{Binding Featured}" core:Anim.FadeIn="True" core:Anim.Delay="70">
                <Grid>
                    <!-- Titelbild zoomt beim Öffnen langsam heran -->
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Hero}" Stretch="UniformToFill" AlignmentY="Top">
                                <ImageBrush.RelativeTransform>
                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1.08" ScaleY="1.08"/>
                                </ImageBrush.RelativeTransform>
                            </ImageBrush>
                        </Border.Background>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                         From="1.08" To="1" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                         From="1.08" To="1" Duration="0:0:1.8">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F50E0E10" Offset="0"/>
                                <GradientStop Color="#B30E0E10" Offset="0.38"/>
                                <GradientStop Color="#000E0E10" Offset="0.75"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border CornerRadius="14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000E0E10" Offset="0.5"/>
                                <GradientStop Color="#990E0E10" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,36" MaxWidth="520">
                        <Border Background="{StaticResource Accent}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,18">
                            <TextBlock Text="IM FOKUS" FontSize="10.5" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <Grid HorizontalAlignment="Left">
                            <Image Source="{Binding Logo}" MaxHeight="104" MaxWidth="360" Stretch="Uniform" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding Name}" FontSize="34" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource H1}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Logo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#D0D0D4" TextWrapping="Wrap" Margin="0,16,0,0"/>

                        <ItemsControl ItemsSource="{Binding Features}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#B3202024" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="#D0D0D4"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                    <TextBlock Text="Editor öffnen"/>
                                </StackPanel>
                            </Button>
                            <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite}" Margin="12,0,0,0"
                                          VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Alle Spiele ===== -->
            <Grid Margin="0,34,0,18" core:Anim.FadeIn="True" core:Anim.Delay="140">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Alle Spiele" Style="{StaticResource H2}" VerticalAlignment="Center"/>

                <!-- Suche -->
                <Grid Grid.Column="1" Width="260" Margin="0,0,10,0">
                    <TextBox Style="{StaticResource SearchBox}" Tag="Spiele suchen"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ClearSearchCommand}" ToolTip="Suche leeren"
                            HorizontalAlignment="Right" Margin="0,0,5,0" Padding="7" Width="28" Height="28"
                            Visibility="{Binding SearchText, Converter={StaticResource TextToVis}}" core:Anim.Pop="True">
                        <Path Data="M1,1 L8,8 M8,1 L1,8" Stroke="{StaticResource Muted}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9"/>
                    </Button>
                </Grid>

                <!-- Filter: Alle | Favoriten -->
                <Border Grid.Column="2" Height="38" CornerRadius="19" Padding="3"
                        Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter" Content="Alle"
                                     IsChecked="{Binding OnlyFavorites, Converter={StaticResource InvBool}}"/>
                        <RadioButton Style="{StaticResource Segment}" GroupName="LibFilter"
                                     IsChecked="{Binding OnlyFavorites}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Star}" Margin="0,0,7,0"/>
                                <TextBlock Text="Favoriten"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <WrapPanel>
                <ItemsControl ItemsSource="{Binding GamesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="188" Margin="0,0,20,20" core:Anim.FadeIn="True" core:Anim.Delay="190">
                                <Border x:Name="frame" Height="282" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent"
                                        Background="{StaticResource Surface2}" Cursor="Hand">
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding OpenCommand}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <TextBlock Text="{Binding Short}" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border x:Name="cover" CornerRadius="10">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Cover}" Stretch="UniformToFill">
                                                    <ImageBrush.RelativeTransform>
                                                        <ScaleTransform CenterX="0.5" CenterY="0.5"/>
                                                    </ImageBrush.RelativeTransform>
                                                </ImageBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="shade" CornerRadius="10" Opacity="0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#000E0E10" Offset="0.45"/>
                                                    <GradientStop Color="#E60E0E10" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="open" Background="{StaticResource Accent}" CornerRadius="8" Padding="0,9"
                                                VerticalAlignment="Bottom" Margin="12" Opacity="0" IsHitTestVisible="False">
                                            <Border.RenderTransform>
                                                <TranslateTransform Y="10"/>
                                            </Border.RenderTransform>
                                            <TextBlock Text="Öffnen" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ToggleButton Style="{StaticResource StarToggle}" IsChecked="{Binding IsFavorite}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="2,11,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Spielstand-Editor" Style="{StaticResource Caption}" FontSize="12" Margin="2,2,0,0"/>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="frame" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="frame" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="frame" Storyboard.TargetProperty="RenderTransform.Y" To="-6" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="cover" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.07" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="cover" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                                 To="1.07" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="open" Storyboard.TargetProperty="Opacity" To="1" BeginTime="0:0:0.05" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="open" Storyboard.TargetProperty="RenderTransform.Y" To="0" BeginTime="0:0:0.05" Duration="0:0:0.3">
                                                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="frame" Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.25"/>
                                                <DoubleAnimation Storyboard.TargetName="cover" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                                 To="1" Duration="0:0:0.35"/>
                                                <DoubleAnimation Storyboard.TargetName="cover" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                                 To="1" Duration="0:0:0.35"/>
                                                <DoubleAnimation Storyboard.TargetName="shade" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="open" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="open" Storyboard.TargetProperty="RenderTransform.Y" To="10" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Platzhalter -->
                <StackPanel Width="188" Margin="0,0,20,20" core:Anim.FadeIn="True" core:Anim.Delay="250">
                    <Grid Height="282">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="{StaticResource LineHover}" StrokeThickness="1.5"
                                   StrokeDashArray="5 4"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource Faint}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Weitere Spiele" Foreground="{StaticResource Muted}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="folgen bald" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="Keine Spiele gefunden." Style="{StaticResource Caption}" FontSize="14"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
