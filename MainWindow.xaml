<Window x:Class="Layts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Layts.ViewModels"
        xmlns:views="clr-namespace:Layts.Views"
        xmlns:ets2="clr-namespace:Layts.Games.Ets2"
        xmlns:core="clr-namespace:Layts.Core"
        Title="layts" Icon="Assets/layts.ico" Width="1320" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ets2:Ets2ViewModel}">
            <ets2:Ets2View/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Seitenleiste ===== -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,0,14,16">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,20,0,30">
                        <Image Source="{StaticResource LogoMark}" Width="30" Height="30"/>
                        <TextBlock Text="layts" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   Margin="11,0,0,2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{core:Tr Menu}" Style="{StaticResource Overline}" Margin="14,0,0,8"/>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Command="{Binding ShowLibraryCommand}"
                            Tag="{Binding IsLibraryActive}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,13,0"/>
                            <TextBlock Text="{core:Tr Library}"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Command="{Binding ShowSettingsCommand}"
                            Tag="{Binding IsSettingsActive}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,13,0"/>
                            <TextBlock Text="{core:Tr Settings}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock DockPanel.Dock="Top" Text="{core:Tr FavoritesHeader}" Style="{StaticResource Overline}" Margin="14,26,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="14,0,8,0" Foreground="{StaticResource Faint}"
                               Visibility="{Binding HasFavorites, Converter={StaticResource InvBoolToVis}}"
                               Text="{core:Tr FavoritesEmpty}"/>

                    <!-- Unten: Updates + Hinweis -->
                    <StackPanel DockPanel.Dock="Bottom" DataContext="{Binding Updater}">

                        <!-- Update verfügbar -->
                        <Border CornerRadius="10" Padding="14" Margin="0,0,0,10" Background="{StaticResource AccentSoft}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" core:Anim.FadeIn="True">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Foreground="{StaticResource Accent}" Margin="0,0,9,0"
                                               core:Anim.Pop="True"/>
                                    <TextBlock Text="{core:Tr UpdateAvailable}" FontWeight="SemiBold" FontSize="13"/>
                                </StackPanel>
                                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,12"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateCommand}" Height="34" FontSize="12.5"
                                        Padding="0" HorizontalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button.Visibility>
                                        <Binding Path="IsBusy" Converter="{StaticResource InvBoolToVis}"/>
                                    </Button.Visibility>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                        <TextBlock Text="{core:Tr UpdateNow}"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}"/>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Version + Suchen -->
                        <Grid Margin="6,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Faint}">
                                <Run Text="layts"/>
                                <Run Text="{Binding CurrentVersion, Mode=OneWay, StringFormat=v{0}}"/>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Command="{Binding CheckCommand}"
                                    Padding="8,5" FontSize="12" ToolTip="{core:Tr CheckUpdatesTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontSize="11" Margin="0,0,6,0"
                                               RenderTransformOrigin="0.5,0.5">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Checking">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard x:Name="Spin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                     From="0" To="360" Duration="0:0:0.8"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="Spin"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{core:Tr CheckUpdates}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Meldung (aktuell / nicht installiert / Fehler) -->
                        <Border CornerRadius="8" Padding="10,8" Margin="0,2,0,8" core:Anim.FadeIn="True" core:Anim.Offset="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="{StaticResource Surface}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="UpToDate">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="NotInstalled">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource Success}"
                                               Margin="0,0,7,0" core:Anim.Pop="True"
                                               Visibility="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=UpToDate}"/>
                                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="180"
                                               Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenReleasesCommand}" Padding="0,6,0,0"
                                        HorizontalAlignment="Left" FontSize="11.5" Foreground="{StaticResource Accent}"
                                        Visibility="{Binding State, Converter={StaticResource StateIs}, ConverterParameter=NotInstalled}">
                                    <TextBlock Text="{core:Tr DownloadInstaller}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{core:Tr SinglePlayerNote}"
                                   Style="{StaticResource Caption}" FontSize="11" Foreground="{StaticResource Faint}" Margin="6,0,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Command="{Binding OpenCommand}" Tag="{Binding IsActive}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="28" Height="28" Margin="-4,0,11,0">
                                            <Border CornerRadius="7" Background="{StaticResource Surface3}">
                                                <TextBlock Text="{Binding Short}" FontSize="8" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="7" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ===== Inhalt ===== -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False"/>

            <!-- ===== Fenster-Buttons (liegen über dem Inhalt) ===== -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                    Background="#B3131316" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="3"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="{core:Tr Minimize}">
                        <Path Style="{StaticResource CaptionIcon}" Data="M2,6 H10"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="{core:Tr Maximize}" Margin="2,0">
                        <Grid>
                            <Path x:Name="MaxIcon" Style="{StaticResource CaptionIcon}"
                                  Data="M3.5,1.75 H8.5 A1.75,1.75 0 0 1 10.25,3.5 V8.5 A1.75,1.75 0 0 1 8.5,10.25 H3.5 A1.75,1.75 0 0 1 1.75,8.5 V3.5 A1.75,1.75 0 0 1 3.5,1.75 Z"/>
                            <Path x:Name="RestoreIcon" Style="{StaticResource CaptionIcon}" Visibility="Collapsed"
                                  Data="M1.75,4.5 H7.5 V10.25 H1.75 Z M4.5,4.5 V1.75 H10.25 V7.5 H7.5"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="{core:Tr Close}">
                        <Path Style="{StaticResource CaptionIcon}" Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
