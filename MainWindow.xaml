<Window x:Class="Layts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Layts.ViewModels"
        xmlns:views="clr-namespace:Layts.Views"
        xmlns:ets2="clr-namespace:Layts.Games.Ets2"
        Title="layts" Icon="Assets/layts.ico" Width="1320" Height="880" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ets2:Ets2ViewModel}">
            <ets2:Ets2View/>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Seitenleiste ===== -->
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="14,0,14,16">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,20,0,30">
                        <Image Source="{StaticResource LogoMark}" Width="30" Height="30"/>
                        <TextBlock Text="layts" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                                   Margin="11,0,0,2" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="MENÜ" Style="{StaticResource Overline}" Margin="14,0,0,8"/>
                    <Button DockPanel.Dock="Top" Style="{StaticResource NavButton}" Command="{Binding ShowLibraryCommand}"
                            Tag="{Binding IsLibraryActive}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="15" Margin="0,0,13,0"/>
                            <TextBlock Text="Bibliothek"/>
                        </StackPanel>
                    </Button>

                    <TextBlock DockPanel.Dock="Top" Text="FAVORITEN" Style="{StaticResource Overline}" Margin="14,26,0,8"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="14,0,8,0" Foreground="{StaticResource Faint}"
                               Visibility="{Binding HasFavorites, Converter={StaticResource InvBoolToVis}}"
                               Text="Markiere Spiele in der Bibliothek mit dem Stern."/>

                    <!-- Unten -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Nur für den Einzelspieler" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Nicht in TruckersMP oder Convoy verwenden." Style="{StaticResource Caption}" FontSize="11.5" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}" Command="{Binding OpenCommand}" Tag="{Binding IsActive}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="28" Height="28" Margin="-4,0,11,0">
                                            <Border CornerRadius="7" Background="{StaticResource Surface3}">
                                                <TextBlock Text="{Binding Short}" FontSize="8" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border CornerRadius="7" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"
                                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="150" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ===== Inhalt ===== -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Focusable="False"/>

            <!-- ===== Fenster-Buttons (liegen über dem Inhalt) ===== -->
            <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0"
                    Background="#B3131316" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="3"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimieren">
                        <Path Style="{StaticResource CaptionIcon}" Data="M2,6 H10"/>
                    </Button>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click" ToolTip="Maximieren" Margin="2,0">
                        <Grid>
                            <Path x:Name="MaxIcon" Style="{StaticResource CaptionIcon}"
                                  Data="M3.5,1.75 H8.5 A1.75,1.75 0 0 1 10.25,3.5 V8.5 A1.75,1.75 0 0 1 8.5,10.25 H3.5 A1.75,1.75 0 0 1 1.75,8.5 V3.5 A1.75,1.75 0 0 1 3.5,1.75 Z"/>
                            <Path x:Name="RestoreIcon" Style="{StaticResource CaptionIcon}" Visibility="Collapsed"
                                  Data="M1.75,4.5 H7.5 V10.25 H1.75 Z M4.5,4.5 V1.75 H10.25 V7.5 H7.5"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="Close_Click" ToolTip="Schließen">
                        <Path Style="{StaticResource CaptionIcon}" Data="M2.5,2.5 L9.5,9.5 M9.5,2.5 L2.5,9.5"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
