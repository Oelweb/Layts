<Application x:Class="Layts.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:Layts.Core"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <core:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
            <core:TextToVisibilityConverter x:Key="TextToVis"/>
            <core:InverseBoolConverter x:Key="InvBool"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
